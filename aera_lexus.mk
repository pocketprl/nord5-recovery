# Screen: 1272x2800 [LOS]. SCREEN_H is aspect*120 (2800/1272 = 19.8:9 -> 2376,
# the same ratio AERA uses for the OnePlus 12).
AERA_UI_ADAPTIVE_RESOLUTION := true
AERA_SCREEN_H := 2376
# VERIFY: status bar height and indents depend on where the punch-hole sits.
# These start from the 1220px-wide peridot values and get tuned on hardware.
AERA_STATUS_H := 115
AERA_HIDE_NOTCH := 1
AERA_STATUS_INDENT_LEFT := 56
AERA_STATUS_INDENT_RIGHT := 48
AERA_OPTIONS_LIST_NUM := 8
AERA_USE_GREEN_LED := 0

# Partitions: A/B with a dedicated recovery_[ab] partition [TW]
AERA_AB_DEVICE_WITH_RECOVERY_PARTITION := 1
AERA_USE_AIDL_BOOT_CONTROL := 1
AERA_DYNAMIC_FULL_SIZE := 13883146240 # VERIFY: matches BOARD_SUPER_PARTITION_SIZE
AERA_ENABLE_ALL_PARTITION_TOOLS := 1
AERA_ENABLE_LPTOOLS := 1
AERA_USE_DMCTL := 1
AERA_NO_TREBLE_COMPATIBILITY_CHECK := 1
AERA_FORCE_PREBUILT_KERNEL := 1

# Data format
AERA_FORCE_DATA_FORMAT_F2FS := 1
AERA_UNBIND_SDCARD_F2FS := 1
AERA_BIND_MOUNT_SDCARD_ON_FORMAT := 1
AERA_WIPE_METADATA_AFTER_DATAFORMAT := 1
AERA_FORCE_CASEFOLDING := 1

# Misc
AERA_USE_LZ4_COMPRESSION := 1
AERA_DISPLAY_FORMAT_FILESYSTEMS_DEBUG_INFO := 1
AERA_ENABLE_FRP_WIPE := 1
AERA_LOOP_DEVICE_ERRORS_TO_LOG := 1
AERA_USE_LOCKSCREEN_BUTTON := 1

# Phase 2: flip on once qca6750 modules/firmware are wired up
AERA_ENABLE_WLAN := 0
